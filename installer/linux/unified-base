#!/bin/sh
# Starts Unified Base on the Python it was installed with. Resolves its own
# location, so the ~/.local/bin symlink and the menu entry both land here.
# -E -s: ignore PYTHONPATH and the user's own ~/.local packages, either of
# which would otherwise load ahead of the bundled Qt.
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/runtime/bin/python3" -E -s "$HERE/app/main.py" "$@"
