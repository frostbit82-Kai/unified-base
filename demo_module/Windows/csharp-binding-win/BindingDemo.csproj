<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows twin of Linux/csharp-binding: the same dashboard in WPF.
       Windows-only by construction; on Linux the launcher publishes a win-x64
       .exe (EnableWindowsTargeting) and runs it through Wine. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF's Fluent theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
</Project>
